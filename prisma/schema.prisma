model JobCard {
  id                 Int       @id @default(autoincrement())
  locationId         Int       @map("location_id")
  jobCardNo          String    @unique @map("job_card_no") @db.NVarChar(30)
  slug               String    @unique @db.NVarChar(180)
  gateEntryId        Int       @map("gate_entry_id")
  customerId         Int       @map("customer_id")
  vehicleId          Int       @map("vehicle_id")
  createdById        Int?      @map("created_by")
  modifiedById       Int?      @map("modified_by")
  expectedDeliveryAt DateTime? @map("expected_delivery_at") @db.DateTime2
  approvalStatusId   Int?      @map("approval_status_id")
  currentStatusId    Int?      @map("current_status_id")
  totalEstimate      Decimal   @default(0) @map("total_estimate") @db.Decimal(10, 2)
  serviceSubtotal    Decimal?  @map("service_subtotal") @db.Decimal(10, 2)
  taxRate            Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount          Decimal?  @map("tax_amount") @db.Decimal(10, 2)
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  finalAmount        Decimal?  @map("final_amount") @db.Decimal(10, 2)
  discountReason     String?   @map("discount_reason") @db.NVarChar(255)
  customerComplaint  String?   @map("customer_complaint")
  additionalNotes    String?   @map("additional_notes")
  createdAt          DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @map("created_at") @db.DateTime2
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime2

  location       Location      @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gateEntry      GateEntry     @relation(fields: [gateEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy      User?         @relation("JobCardCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modifiedBy     User?         @relation("JobCardModifiedBy", fields: [modifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvalStatus StatusMaster? @relation("JobCardApprovalStatus", fields: [approvalStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentStatus  StatusMaster? @relation("JobCardCurrentStatus", fields: [currentStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approvals       JobCardApproval[]
  services        JobCardService[]
  workAssignments WorkAssignment[]
  statusLogs      JobCardStatusLog[]
  notifications   Notification[]

  processStageTrackings ProcessStageTracking[]
  notifications Notification[]

  @@map("job_cards")
}

